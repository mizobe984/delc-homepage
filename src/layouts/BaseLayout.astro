---
import Header from '../components/DelcHeader.astro'
import Footer from '../components/DelcFooter.astro'
import BrandingLogo from '@/components/BrandingLogo.astro'
import '../styles/globals.css'
import '../styles/delcGlobal.css'
import '../styles/baseTopPageTextBox.css'
import { ClientRouter } from 'astro:transitions'

const {
  pageTitle,
  tabTitle,
  pageTitleRuby,
  destinationURLs,
  description,
  fullWidthMain,
} = Astro.props

const DEFAULT_DESCRIPTION =
  '株式会社デルク(DELC)は、ゲーム・ソフトウェアのデバッグ/品質保証(QA)と SES を主軸とする東京・池袋の企業です。先進的な品質保証とエンジニアリングサポートを通じてデジタル世界をより良くします。'
const metaDescription = description || DEFAULT_DESCRIPTION
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

import { Toaster } from '@/components/ui/toaster'

import '@fontsource-variable/open-sans'
import '@fontsource-variable/cabin'
import '@fontsource-variable/noto-sans-jp'

import BreadCrumb from '@/components/BreadCrumb.astro'
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{tabTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content="株式会社デルク" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tabTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
  </head>
  <body class="font-body">
    <Header />

    <!-- HERO SECTION -->
    <div
      class="hero-sky relative flex min-h-[32rem] flex-col justify-between overflow-clip border-b border-b-secondary xl:min-h-[44rem]"
    >
      <div
        class="hero-logo-image hero-logo-focus absolute left-0 top-24 h-[800px] min-w-full max-md:left-1/4 max-md:top-8 xl:top-12 xl:h-[1200px]"
      >
      </div>
      <BrandingLogo />
      <div class="z-40 mb-12 ml-12 animate-fadeInUp max-md:ml-6">
        {
          destinationURLs && destinationURLs.length > 0 && (
            <div class="page-title-block">
              <div class="page-title-ruby">{pageTitleRuby}</div>
              <h1 class="page-title text-shadow">{pageTitle}</h1>
              <BreadCrumb destinationURLs={destinationURLs} />
            </div>
          )
        }
        <slot name="hero" />
      </div>
    </div>

    <!-- relative z-10 + 不透明背景: スクロールで固定された透かしロゴ(z-0)の上に
         せり上がり、下の領域が透かしロゴを覆って隠す -->
    <div
      class:list={[
        'home-main-block relative z-10 bg-background',
        !fullWidthMain && 'px-6',
      ]}
    >
      <slot />
    </div>

    <Footer />

    <Toaster client:idle />

    <script>
      import '../scripts/menu.js'
    </script>
  </body>
</html>
