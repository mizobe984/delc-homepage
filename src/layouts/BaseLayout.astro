---
import Header from '../components/DelcHeader.astro'
import Footer from '../components/DelcFooter.astro'
import BrandingLogo from '@/components/BrandingLogo.astro'
import '../styles/globals.css'
import '../styles/delcGlobal.css'
import '../styles/baseTopPageTextBox.css'
import { ClientRouter } from 'astro:transitions'

const { pageTitle, tabTitle, pageTitleRuby, destinationURLs } = Astro.props

import { Toaster } from '@/components/ui/toaster'

import '@fontsource-variable/open-sans'
import '@fontsource-variable/cabin'

import BreadCrumb from '@/components/BreadCrumb.astro'
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{tabTitle}</title>
    <ClientRouter />
  </head>
  <body class="font-body">
    <Header />

    <!-- HERO SECTION -->
    <div
      class="expand relative h-[32rem] overflow-clip border-b border-b-secondary xl:h-[44rem]"
    >
      <div
        class="hero-logo-image absolute left-0 top-24 h-[800px] min-w-full bg-gradient-to-t from-secondary to-secondary/90 max-md:left-1/4 max-md:top-8 xl:top-12 xl:h-[1200px]"
      >
      </div>
      <BrandingLogo />
      <div
        class="absolute bottom-0 z-40 mb-12 ml-12 animate-fadeInUp max-md:ml-6"
      >
        {
          destinationURLs && destinationURLs.length > 0 && (
            <div class="page-title-block">
              <div class="page-title-ruby">{pageTitleRuby}</div>
              <div class="page-title text-shadow">{pageTitle}</div>
              <BreadCrumb destinationURLs={destinationURLs} />
            </div>
          )
        }
        <slot name="hero" />
      </div>
    </div>

    <div class="home-main-block">
      <slot />
    </div>

    <Footer />

    <Toaster client:idle />

    <script>
      import '../scripts/menu.js'
    </script>
  </body>
</html>
