---
import '../styles/newsList.css'

import { getSortedPosts } from '@/lib/posts'

const displayedArticles = await getSortedPosts(3)
---

<div class="newslist space-y-2">
  {
    displayedArticles.map((entry) => (
      <div class="news-block group border-b border-foreground/30">
        <p>{entry.data.pubDate.toLocaleDateString('ja-JP')}</p>
        <div class="news-title transition-all group-hover:underline">
          <a href={'/posts/' + entry.slug}>{entry.data.title}</a>
        </div>
      </div>
    ))
  }
</div>
