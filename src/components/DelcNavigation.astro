---
import { Building } from 'lucide-astro'
import { Presentation } from 'lucide-astro'
import { UserSearch } from 'lucide-astro'
import { Mail } from 'lucide-astro'

import '../styles/header.css'

import { cn } from '@/lib/utils'
import { companyMenus, serviceLinks } from '@/lib/navigation'
---

<div class="nav-links">
  <div class="nav-branding relative">
    <a href="/" class="w-30 group">
      <div class="branding-logo">
        <div class={cn('cmp-branding', 'bg-clr')}></div>
        <div
          class={cn(
            'cmp-logo',
            'bg-clr',
            'translate-y-[1px]',
            'group-hover:-translate-y-[1px] transition-all',
          )}
        >
        </div>
      </div>
    </a>
  </div>

  <div class="nav-links-block">
    <div class="pulldown-menu">
      <a href="/company/" class="responsive-link" data-astro-reload>
        <div class="detection-size border-top link-format">
          <Building size={20} />会社情報
        </div>
      </a>
      <div class="links-detail">
        {
          companyMenus.map((menu) => (
            <a href={`/${menu.url}/`} class="detection-size" data-astro-reload>
              {menu.text}
            </a>
          ))
        }
      </div>
    </div>

    <div class="pulldown-menu">
      <a href="/services/" class="responsive-link" data-astro-reload>
        <div class="detection-size border-top link-format">
          <Presentation size={20} />事業案内
        </div>
      </a>
      <div class="links-detail">
        {
          serviceLinks.map((service) => (
            <a href={service.url} class="detection-size" data-astro-reload>
              {service.title}
            </a>
          ))
        }
      </div>
    </div>

    <a href="/recruit/" class="detection-size border-top"
      ><div class="link-format"><UserSearch size={20} />求人情報</div></a
    >

    <a href="/contact/" class="detection-size border-top"
      ><div class="link-format"><Mail size={20} />お問い合わせ</div></a
    >

    <div class="menu-bottom-space border-top"></div>
  </div>
</div>
