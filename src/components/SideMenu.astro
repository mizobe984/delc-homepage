---
import '../styles/sideMenu.css'

type MenuItem = { url: string; text: string }

const { menus, showMenu, anchor } = Astro.props as {
  menus?: MenuItem[]
  showMenu: boolean
  anchor: boolean
}

const prefix = anchor ? '#' : '/'
---

<sideMenu>
  {
    showMenu && menus && menus.length > 0 && (
      <div class="side-menu-block">
        <div class="side-menu">
          {menus.map((menu) => (
            <a href={prefix + menu.url}>{'・' + menu.text}</a>
          ))}
        </div>
      </div>
    )
  }
</sideMenu>
