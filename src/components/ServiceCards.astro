---
import { cn } from '@/lib/utils'
import Button from './Button.astro'
import {
  Card,
  CardTitle,
  CardContent,
  CardDescription,
  CardFooter,
} from './ui/card'

type ParameterTable = {
  title: string
  description: string
  url: string
}

const parameterTable: ParameterTable[] = [
  {
    title: 'デバッグサービス事業',
    description: 'Testify Solutions',
    url: 'services/#debug',
  },
  {
    title: 'SES事業',
    description: 'TechTalent Hub',
    url: 'services/#ses',
  },
]

const ts = [
  'flex',
  'justify-between', // CardTitle の -mr-28 と組み合わせると、一応見出しが1行で収まった
  'md:w-[28rem]',
  'pt-5',
  'mt-3',
  'rounded-none',
  'rounded-e-full',
  'shadow-xl',
  'border-none',
]
---

<div class="ml-3 mt-5">
  {
    parameterTable.map((data, index) => {
      const mlIndent = cn(
        index === 0 ? '' : index === 1 ? 'md:ml-8' : 'md:ml-16',
      )
      return (
        <Card className={cn(...ts, mlIndent)}>
          <div>
            <CardContent>
              <CardTitle className="text-lg font-normal -mr-28">
                {data.title}
              </CardTitle>
              <CardDescription>{data.description}</CardDescription>
            </CardContent>
          </div>
          <CardFooter>
            <Button variant="default" className="text-primary-foreground">
              <a href={data.url}>VIEW MORE</a>
            </Button>
          </CardFooter>
        </Card>
      )
    })
  }
</div>
