---
import { cn } from '@/lib/utils'
import Button from './Button.astro'
import {
  Card,
  CardTitle,
  CardContent,
  CardDescription,
  CardFooter,
} from './ui/card'
import { serviceLinks } from '@/lib/navigation'

const ts = [
  'flex',
  'items-center',
  'justify-between',
  'md:w-[28rem]',
  'pt-5',
  'mt-3',
  'rounded-none',
  'rounded-e-full',
  'shadow-xl',
  'border-none',
]
---

<div class="ml-3 mt-5">
  {
    serviceLinks.map((data, index) => {
      const mlIndent = cn(
        index === 0 ? '' : index === 1 ? 'md:ml-8' : 'md:ml-16',
      )
      return (
        <Card className={cn(...ts, mlIndent)}>
          <div class="min-w-0 flex-1">
            <CardContent>
              <CardTitle className="text-lg font-normal">
                {data.title}
              </CardTitle>
              <CardDescription>{data.description}</CardDescription>
            </CardContent>
          </div>
          <CardFooter className="shrink-0">
            <Button
              variant="default"
              className="w-36 text-primary-foreground"
              href={data.url}
            >
              VIEW MORE
            </Button>
          </CardFooter>
        </Card>
      )
    })
  }
</div>
