---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { ChevronRight } from 'lucide-astro'

/**
 * シェブロン付きボタン。href を渡すと <a>、渡さなければ <button> として
 * 1要素でレンダリングする(a/button のネストを作らないため)。
 */
const { variant, className, href } = Astro.props

// inline-flex + 固定幅(w-52)で、親要素の幅に引き伸ばされないようにする。
// className を後ろに置くことで呼び出し側から幅などを上書き可能
const classes = cn(
  buttonVariants({ variant }),
  'group relative inline-flex w-52 px-8',
  className,
)

const Tag = href ? 'a' : 'button'
---

<Tag href={href} class={classes}>
  <div class="-ml-4">
    <slot />
  </div>
  <ChevronRight
    size={20}
    class="absolute right-[10px] transition-all group-hover:translate-x-[6px]"
  />
  <ChevronRight
    size={20}
    class="absolute right-[4px] transition-all group-hover:-translate-x-[6px]"
  />
</Tag>
