---
import { Image } from 'astro:assets'
import '../styles/news.css'
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'

import { getSortedPosts } from '@/lib/posts'

const DescArticleLists = await getSortedPosts()
---

<div class="news">
  {
    DescArticleLists.map((entry) => (
      <Card className="card-fixed border-0 shadow-lg">
        <a href={'/posts/' + entry.slug}>
          <CardHeader>
            {entry.data.image ? (
              <Image
                src={entry.data.image.url}
                alt={entry.data.image.alt}
                width={640}
                class="fixed-image"
              />
            ) : (
              <img
                src="/images/branding.svg"
                alt="株式会社デルク"
                width="640"
                height="320"
                class="fixed-image"
              />
            )}
          </CardHeader>
          <CardContent className="space-y-1">
            <CardTitle>{entry.data.title}</CardTitle>
            <CardDescription>
              {entry.data.pubDate.toLocaleDateString('ja-JP')}
            </CardDescription>
          </CardContent>
        </a>
      </Card>
    ))
  }
</div>
