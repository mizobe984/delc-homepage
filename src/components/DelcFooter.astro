---
import BrandingLogo from '@/components/BrandingLogo.astro'
---

<style>
  :root {
    --left-margin: 2rem;
  }

  footer {
    color: hsl(var(--primary-foreground));
    background-color: hsl(var(--primary));
    margin-top: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-rows: 5rem 3.1rem 1.4rem 1.4rem 1.4rem 1fr 1fr 1fr;
    grid-template-columns: 20rem auto 20rem;
    gap: 0.5rem;
    background-color: inherit;
    letter-spacing: 0.025rem;
    padding-top: 2rem;
  }

  .footer-grid p {
    margin: 0;
  }

  /* 住所ブロック自体はレイアウトに関与させず、子要素をグリッドに直接配置する */
  address {
    display: contents;
    font-style: normal;
  }

  .subcompany {
    grid-row: 2;
    grid-column: 1;
    width: 120px;
    margin: 0 0 0 var(--left-margin);
  }

  .post-code {
    grid-row: 3;
    grid-column: 1;
    width: 300px;
    margin: 0 0 0 var(--left-margin);
  }

  .location {
    grid-row: 4;
    grid-column: 1;
    width: 300px;
    margin: 0 0 0 var(--left-margin);
  }

  .tel-fax {
    grid-row: 5;
    grid-column: 1;
    margin: 0 0 0 var(--left-margin);
  }

  .privacy-policy {
    grid-row: 6;
    grid-column: 1;

    /* BrandingLogo のラッパー(z-10, 高さ21rem)がこの行まで被さるため、
       リンクをクリック可能にするには z-10 より手前に置く必要がある */
    z-index: 20;

    margin: 1rem 0 1rem var(--left-margin);
    text-decoration: underline;
    text-decoration-color: hsl(0, 0%, 100%);
  }

  .copyright {
    padding: 1rem 0 1rem 0;
  }

  @media (min-width: 768px) {
    .copyright {
      grid-row: 6;
      grid-column: 3;

      justify-self: center;
    }
  }

  @media (max-width: 767px) {
    /*スマホ*/
    .copyright {
      grid-row: 7;
      grid-column: 1;

      margin: 0 0 0 var(--left-margin);
    }
  }
</style>

<footer class="expand">
  <div class="footer-grid">
    <BrandingLogo color="bg-primary-foreground" />
    <p class="subcompany">株式会社デルク</p>
    <address>
      <p class="post-code">〒171-0022</p>
      <p class="location">東京都豊島区南池袋2-5-3 SSビル2F</p>
      <p class="tel-fax">TEL:03-5985-4109 FAX:03-5985-4147</p>
    </address>
    <p class="privacy-policy">
      <a href="/privacyPolicy/">プライバシーポリシー</a>
    </p>
    <p class="copyright">©Delc Inc.</p>
  </div>
</footer>
