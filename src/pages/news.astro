---
import '@/styles/globals.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import NewsMainView from '../components/NewsMainView.astro'
import '@/styles/baseTopPageTextBox.css'

const pageTitle = 'NEWS'
const pageTitleRuby = 'お知らせ一覧'
const tabTitle = 'お知らせ一覧'
const destinationURLs = [{ url: 'news', ruby: 'お知らせ一覧' }]
---

<BaseLayout {pageTitle} {tabTitle} {pageTitleRuby} {destinationURLs}>
  <div class="expand -mb-32 bg-secondary pb-32 pl-8 pt-8">
    <NewsMainView />
  </div>
</BaseLayout>
