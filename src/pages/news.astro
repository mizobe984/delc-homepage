---
import '@/styles/globals.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import NewsMainView from '../components/NewsMainView.astro'
import '@/styles/baseTopPageTextBox.css'

const pageTitle = 'NEWS'
const pageTitleRuby = 'お知らせ'
const tabTitle = 'お知らせ'
const destinationURLs = [{ url: 'news', ruby: 'お知らせ' }]
---

<BaseLayout {pageTitle} {tabTitle} {pageTitleRuby} {destinationURLs}>
  <div class="bg-secondary expand -mb-32 pt-8 pb-32 pl-8">
    <NewsMainView />
  </div>
</BaseLayout>
