---
import '@/styles/globals.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import NewsMainView from '../components/NewsMainView.astro'
import '@/styles/baseTopPageTextBox.css'

const pageTitle = 'NEWS'
const pageTitleRuby = 'お知らせ一覧'
const tabTitle = 'お知らせ一覧'
const destinationURLs = [{ url: 'news', ruby: 'お知らせ一覧' }]
---

<BaseLayout
  {pageTitle}
  {tabTitle}
  {pageTitleRuby}
  {destinationURLs}
  fullWidthMain
>
  <!-- pl-14 = 旧 body パディング 1.5rem + pl-8(.expand 廃止に伴う読み替え) -->
  <div class="-mb-32 bg-secondary pb-32 pl-8 pr-6 pt-8">
    <NewsMainView />
  </div>
</BaseLayout>
