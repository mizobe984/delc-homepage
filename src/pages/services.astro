---
import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'
import '@/styles/services.css'
import WithSideMenuLayout from '@/layouts/WithSideMenuLayout.astro'

import { Image } from 'astro:assets'
import debugImage from '@/assets/images/debug.jpg'
import sesImage from '@/assets/images/ses.jpg'

import type { SideMenuParams } from '@/lib/types'
import { serviceMenus, breadcrumbs } from '@/lib/navigation'

const params: SideMenuParams = {
  companyName: 'DELC',
  pageTitle: 'SERVICES',
  pageTitleRuby: '事業案内',
  tabTitle: '事業案内',
  menuTitle: 'SERVICES',
  menus: serviceMenus,
  showMenu: true,
  mainBlockSize: 2,
  anchor: true,
  destinationURLs: breadcrumbs.services,
}
---

<WithSideMenuLayout {...params}>
  <div class="large-text p-5">
    <section class="pp-category">
      <h2 id="debug">デバッグサービス事業</h2>

      <Image src={debugImage} alt="デバッグ作業の様子" width={1024} />

      <h3>サービス概要</h3>
      <p>
        お客様のゲームやソフトウェアに対し、ユーザー目線でのデバッグや改善提案および、タイムリーなコミュニケーションを重視して検証を行います。
        豊富な実績から導出されたソリューションを用いて早期の不具合発見、再発防止を目指しお客様のサービス品質向上を実現いたします。
      </p>
      <h3>実績紹介</h3>
      <h4>1. ガイドラインチェックサービス</h4>
      <p>
        PC/iOS/android対応アプリ
        プラットフォーマーにおける各種ガイドライン審査を主に行っております。
      </p>
      <h4>2. ソーシャルネイティブアプリのイニシャルデバッグ</h4>
      <p>
        iOS/android対応RPG
        正常動作確認、データ検証、表示検証、イレギュラーチェックなどリリース前における総合デバッグを行っております。
      </p>
      <h4>3. WEBアプリの単体・結合テスト</h4>
      <p>
        リリース直前のサービスに対するテストケースの作成及び単体テスト、結合テストを主に行っております。
      </p>
      <h4>4. ソーシャルネイティブアプリの運営デバッグ</h4>
      <p>
        iOS/android対応IPタイトル
        定期的にリリースされる追加施策の正常動作確認やキャラチェック、シナリオチェックなど、リリース後の総合デバッグを行っております。
      </p>

      <h3>対応環境</h3>
      <ul>
        <li>android</li>
        <li>Steam PC</li>
        <li>SONY PS4/PS5</li>
        <li>Nintendo Switch</li>
      </ul>
    </section>

    <section class="pp-category">
      <h2 id="ses">SES事業</h2>
      <Image src={sesImage} alt="エンジニアの作業風景" width={1024} />

      <h3>サービス概要</h3>
      <p>
        フリーランスのエンジニアと企業をマッチングさせ、個人の働き方やプロジェクトのニーズに合わせた最適なマッチングを行います。
        QAやRPAなど特定の領域に強い、ハイスキルかつ豊富なプロフェッショナル人材プールにより、迅速なマッチングと課題解決を支援します。
      </p>
      <h3>実績紹介</h3>
      <h4>1. ソーシャルネイティブアプリのプロジェクト</h4>
      <p>
        PC/iOS/android対応アプリ
        QA領域のPMOとして、テスト管理、テスト計画管理、エンジニアチームとの連携やフロー改善業務などを主に行っております。
      </p>
      <h4>2. VRアプリのプロジェクト</h4>
      <p>
        QAエンジニアとして、仕様の把握、テスト設計と実施、エンジニアチームへのバグレポート提出と改修依頼を行っております。
      </p>
    </section>
  </div>
</WithSideMenuLayout>
