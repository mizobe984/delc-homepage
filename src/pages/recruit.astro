---
import { ExternalLink } from 'lucide-react'

import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'
import '@/styles/recruit.css'

import BaseLayout from '../layouts/WithSideMenuLayout.astro'
import { breadcrumbs } from '@/lib/navigation'

const companyName = 'DELC'
const pageTitle = 'RECRUIT'
const pageTitleRuby = '求人情報'
const tabTitle = '求人情報'

const destinationURLs = breadcrumbs.recruit

const menus = [{ url: 'recruit', text: '求人情報' }]

const hide = 1
---

<BaseLayout
  companyName={companyName}
  pageTitle={pageTitle}
  pageTitleRuby={pageTitleRuby}
  tabTitle={tabTitle}
  menus={menus}
  menuShow={hide}
  mainBlockSize={'1/3'}
  anchor={false}
  destinationURLs={destinationURLs}
>
  <div class="mt-12 space-y-8 pb-32 pl-3">
    <h1
      class="-ml-3 bg-gradient-to-r from-primary to-secondary p-4 text-3xl font-extrabold italic text-primary-foreground text-shadow"
    >
      一緒に働きましょう！
    </h1>

    <p class="flex">
      <a
        href="https://herp.careers/v1/delc"
        class="hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        求職一覧へ
      </a>
      <ExternalLink />
    </p>
    <p class="flex text-muted-foreground">
      エンジニア登録フォーム
      <ExternalLink />

      ※近日公開
    </p>
  </div>
</BaseLayout>
