---
import { ExternalLink, Loader2 } from 'lucide-react'
import Button from '@/components/Button.astro'
import { WifiOff } from 'lucide-astro'

import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'
import '@/styles/recruit.css'

import BaseLayout from '../layouts/WithSideMenuLayout.astro'

import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table'

const companyName = 'DELC'
const pageTitle = 'RECRUIT'
const pageTitleRuby = '求人情報'
const tabTitle = '求人情報'

const companyInformation = '求人情報'
const information = 'RECRUIT'

const destinationURLs = [{ url: 'recruit', ruby: '求人情報' }]

const menus = [{ url: 'recruit', text: '求人情報' }]

const hide = 1
---

<BaseLayout
  companyName={companyName}
  pageTitle={pageTitle}
  pageTitleRuby={pageTitleRuby}
  tabTitle={tabTitle}
  menus={menus}
  menuShow={hide}
  mainBlockSize={'1/3'}
  anchor={false}
  destinationURLs={destinationURLs}
>
  <div class="space-y-8 mt-12 pl-3 pb-32">
    <h1
      class="-ml-3 italic bg-gradient-to-r from-primary to-secondary text-3xl text-shadow font-extrabold text-primary-foreground p-4"
    >
      一緒に働きましょう！
    </h1>

    <p class="flex">
      <a
        href="https://herp.careers/v1/delc"
        class="hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        求職一覧へ
      </a>
      <ExternalLink />
    </p>
    <p class="flex text-muted-foreground">
      エンジニア登録フォーム
      <ExternalLink />

      ※近日公開
    </p>
  </div>
</BaseLayout>
