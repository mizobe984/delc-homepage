---
import Button from '@/components/Button.astro'

import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'

import BaseLayout from '../layouts/BaseLayout.astro'

import NewsList from '../components/NewsList.astro'
import ServiceCards from '@/components/ServiceCards.astro'

type Article = {
  title: string
  description: string
  url: string
}

const pageTitle = 'DELC'
const tabTitle = 'DELC(株式会社デルク)'
---

<BaseLayout pageTitle={pageTitle} tabTitle={tabTitle}>
  <Fragment slot="hero">
    <pre
      class="ml-6 whitespace-pre-line font-pre text-xl leading-8 tracking-wider max-md:text-lg">
      先進的な品質保証と
      エンジニアリングサポートを通じて
      デジタル世界をより良くする
    </pre>
  </Fragment>

  <div class="news expand">
    <div class="header">
      <div class="title-jp">お知らせ</div>
      <div class="title text-shadow">NEWS</div>
    </div>
    <NewsList />
    <div class="ml-6 mt-12">
      <a href="/news"><Button variant="default">VIEW MORE</Button></a>
    </div>
  </div>

  <div
    class="businessContents expand relative overflow-clip bg-primary text-primary-foreground"
  >
    <div class="flex h-96 animate-fadeInUp space-x-4 rounded-xl px-6">
      <div class="element-padding absolute z-10">
        <p class="header">会社情報</p>
        <p class="header-ruby text-shadow">COMPANY</p>
        <pre
          class="info ml-6 whitespace-pre-line font-pre tracking-wider">
            私たちは、デジタル技術の進化を支えることで利便性と快適さを向上させ、社会全体の発展に貢献することを目指します。

            そのために、卓越した検証サービスやエンジニアリングサポートを提供すると同時に、技術的な課題解決・品質改善に継続的に取り組み、人々の生活を豊かにすべく活動を行います。
          </pre>

        <div class="view-button ml-6 mt-12 text-primary">
          <a href="/company"><Button variant="outline">VIEW MORE</Button></a>
        </div>
      </div>
      <div
        class="logo-image bg-gradient-to-b from-accent-foreground/90 via-accent-foreground to-accent-foreground"
      >
      </div>
    </div>
  </div>

  <div class="businessContents h-[32rem]">
    <div class="element-padding">
      <p class="header">事業案内</p>
      <p class="header-ruby text-shadow">SERVICES</p>
    </div>
    <ServiceCards />
  </div>

  <div
    class="businessContents expand relative h-[32rem] overflow-clip bg-secondary"
  >
    <div class="ml-5 flex animate-fadeInUp items-start space-x-4 rounded-xl">
      <div class="element-padding absolute">
        <p class="header">求人情報</p>
        <p class="header-ruby text-shadow">RECRUIT</p>
      </div>
      <div class="view-button z-50 mt-32">
        <a href="https://herp.careers/v1/delc"><Button>VIEW MORE</Button></a>
      </div>
      <div
        class="logo-image bg-gradient-to-b from-background/90 via-background to-background"
      >
      </div>
    </div>
  </div>

  <div class="businessContents flex h-[32rem] items-start justify-between">
    <div class="flex animate-fadeInUp items-center space-x-4 rounded-xl">
      <div class="element-padding">
        <p class="header">お問い合わせ</p>
        <p class="header-ruby text-shadow">CONTACT</p>

        <div class="view-button ml-4 mt-8">
          <a href="/contact"><Button variant="outline">CLICK HERE</Button></a>
        </div>
      </div>
    </div>
    <div
      class="ml-4 mt-6 h-full w-11/12 max-w-[40rem] rounded-3xl bg-[url('/images/contact.jpg')] bg-cover bg-left bg-no-repeat shadow-md"
    >
    </div>
  </div>
</BaseLayout>
