---
import { getImage } from 'astro:assets'
import Button from '@/components/Button.astro'

import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'

import BaseLayout from '../layouts/BaseLayout.astro'

import NewsList from '../components/NewsList.astro'
import ServiceCards from '@/components/ServiceCards.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import contactImage from '@/assets/images/contact.jpg'

const pageTitle = 'DELC'
const tabTitle = 'DELC(株式会社デルク)'

// CSS background-image は <Image /> を使えないため getImage() で最適化した URL を使う
const contactBg = await getImage({ src: contactImage, width: 1280 })

// セクション共通レイアウト。高さを揃えるための min-h は、最も背の高い
// CONTACT セクションの実測値に合わせた値(SP: 35rem / PC: 33rem)。
// 固定高さではなく min-h + 中央寄せなので、コンテンツが増えても溢れない
const sectionClass =
  'flex min-h-[35rem] flex-col justify-center px-6 py-10 md:min-h-[33rem] md:px-10'
---

<BaseLayout pageTitle={pageTitle} tabTitle={tabTitle} fullWidthMain>
  <Fragment slot="hero">
    <h1 class="sr-only">株式会社デルク(DELC)</h1>
    <p class="ml-6 font-sans text-xl leading-8 tracking-wider max-md:text-lg">
      先進的な品質保証と<br />
      エンジニアリングサポートを通じて<br />
      デジタル世界をより良くする
    </p>
  </Fragment>

  <section class:list={[sectionClass, 'bg-secondary']}>
    <SectionHeader jp="お知らせ" en="NEWS" />
    <NewsList />
    <div class="ml-6 mt-8">
      <Button href="/news" variant="default">VIEW MORE</Button>
    </div>
  </section>

  <section
    class:list={[
      sectionClass,
      'relative overflow-clip bg-primary text-primary-foreground',
    ]}
  >
    <div
      class="logo-image pointer-events-none bg-gradient-to-b from-accent-foreground/90 via-accent-foreground to-accent-foreground"
    >
    </div>
    <div class="relative z-10 animate-fadeInUp">
      <SectionHeader jp="会社情報" en="COMPANY" />
      <div class="ml-6 mt-4 max-w-2xl space-y-4 font-sans tracking-wider">
        <p>
          私たちは、デジタル技術の進化を支えることで利便性と快適さを向上させ、社会全体の発展に貢献することを目指します。
        </p>
        <p>
          そのために、卓越した検証サービスやエンジニアリングサポートを提供すると同時に、技術的な課題解決・品質改善に継続的に取り組み、人々の生活を豊かにすべく活動を行います。
        </p>
      </div>

      <div class="ml-6 mt-10 text-primary">
        <Button href="/company" variant="outline">VIEW MORE</Button>
      </div>
    </div>
  </section>

  <section class:list={[sectionClass]}>
    <SectionHeader jp="事業案内" en="SERVICES" />
    <ServiceCards />
  </section>

  <section class:list={[sectionClass, 'relative overflow-clip bg-secondary']}>
    <div
      class="logo-image pointer-events-none bg-gradient-to-b from-background/90 via-background to-background"
    >
    </div>
    <div class="relative z-10 animate-fadeInUp">
      <SectionHeader jp="求人情報" en="RECRUIT" />
      <div class="ml-6 mt-10">
        <Button href="https://herp.careers/v1/delc">VIEW MORE</Button>
      </div>
    </div>
  </section>

  <section class:list={[sectionClass]}>
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div class="animate-fadeInUp">
        <SectionHeader jp="お問い合わせ" en="CONTACT" />
        <div class="ml-6 mt-8">
          <Button href="/contact" variant="outline">CLICK HERE</Button>
        </div>
      </div>
      <!-- 元画像(4752x3168)と同じ 3:2 比率で高さを決める(固定高さの代替) -->
      <div
        class="aspect-[3/2] w-full max-w-[40rem] rounded-3xl bg-cover bg-left bg-no-repeat shadow-md"
        style={`background-image: url(${contactBg.src});`}
      >
      </div>
    </div>
  </section>
</BaseLayout>
