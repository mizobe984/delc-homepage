---
import { ExternalLink } from 'lucide-astro'

import '@/styles/globals.css'
import '@/styles/baseTopPageTextBox.css'
import '@/styles/delcInfoGlobal.css'

import WithSideMenuLayout from '../layouts/WithSideMenuLayout.astro'

import type { SideMenuParams } from '@/lib/types'
import { companyMenus, breadcrumbs } from '@/lib/navigation'

const params: SideMenuParams = {
  companyName: 'DELC',
  pageTitle: 'INFORMATION',
  pageTitleRuby: '会社概要',
  tabTitle: '会社情報',
  menuTitle: 'COMPANY',
  menus: companyMenus,
  showMenu: true,
  mainBlockSize: 2,
  anchor: false,
  destinationURLs: breadcrumbs.company,
}

const companyTable = [
  {
    title: '会社名',
    content: '株式会社デルク',
  },
  {
    title: '設立',
    content: '2014年4月',
  },
  {
    title: '所在地',
    content: '〒171-0022 東京都豊島区南池袋2-5-3 SSビル2F',
  },
  {
    title: '代表',
    content: '代表取締役 溝部 陽史',
  },
  {
    title: '資本金',
    content: '9,000,000円',
  },
  {
    title: '事業内容',
    content: `デバッグサービス事業
SES事業`,
  },
  {
    title: '取引銀行',
    content: `みずほ銀行 池袋西口支店
巣鴨信用金庫 東池袋支店`,
  },
  {
    title: '顧問税理士',
    content: 'シルスフィア税理士事務所',
    url: 'http://silsphere.jp/',
  },
  {
    title: '適格請求書発行事業者登録番号',
    content: '国税庁適格請求書発行事業者公表サイト',
    url: 'https://www.invoice-kohyo.nta.go.jp/regno-search/detail?selRegNo=7013301035178',
  },
]

// 複数行の content は行ごとに <p> にする(旧 <pre> レイアウトの置き換え)
const companyRows = companyTable.map((item) => ({
  ...item,
  lines: item.content.split('\n'),
}))
---

<WithSideMenuLayout {...params}>
  <dl class="mt-6 grid grid-cols-[auto_1fr] text-sm max-md:grid-cols-1">
    {
      companyRows.map((item, index) => {
        const border = index === companyRows.length - 1 ? '' : 'border-b'
        return (
          <Fragment>
            <dt
              class:list={[
                'flex items-center p-5 text-xs font-semibold',
                border,
                'max-md:border-0 max-md:pb-0',
              ]}
            >
              {item.title}
            </dt>
            <dd class:list={['large-text p-5 max-md:pt-2', border]}>
              {item.url ? (
                <a
                  href={item.url}
                  class="hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.content}
                  <ExternalLink />
                </a>
              ) : (
                item.lines.map((line) => <p>{line}</p>)
              )}
            </dd>
          </Fragment>
        )
      })
    }
  </dl>
</WithSideMenuLayout>
